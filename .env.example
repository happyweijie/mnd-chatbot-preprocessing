# Copy to .env for local runs; on SageMaker set these via the job environment
# (real environment variables always take precedence over .env values).

# required for phase 4 (embedding)
OPENAI_API_KEY=sk-...

# optional: gov endpoint; scheme is added automatically if missing
# OPENAI_BASE_URL=https://api.ai.tech.gov.sg/platform/models

# optional: embedding model (default: text-embedding-3-small)
# EMBEDDING_MODEL=text-embedding-3-large

# optional: embedding dimensions; leave unset to use the model's default
# (1536 for text-embedding-3-small, 3072 for text-embedding-3-large)
# EMBEDDING_DIM=1536
